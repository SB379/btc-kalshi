# Logging
RUST_LOG=info                 # trace | debug | info | warn | error
LOG_FORMAT=pretty             # pretty (dev) | json (prod)

# Kalshi
KALSHI_API_KEY=
KALSHI_API_SECRET=
KALSHI_USE_DEMO=true
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# CF Benchmarks (when licensed)
CF_BENCHMARKS_API_KEY=
CF_BENCHMARKS_BASE_URL=

# Risk limits
MAX_POSITION_SIZE_CENTS=2000
MAX_DAILY_LOSS_CENTS=5000
KELLY_FRACTION=0.25
MAX_CONTRACTS=100            # hard cap per market (Kalshi retail limit)
REENTRY_LOSS_THRESHOLD_CENTS=10 # suppress same thesis re-entry after losses >= this threshold

# Compare mode — set to false to disable all trading and print BRTI vs Kalshi comparison
TRADING_ENABLED=true
